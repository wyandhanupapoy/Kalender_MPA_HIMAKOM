rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin' && getUserData().isActive == true;
    }
    
    function isPengurus() {
      return isAuthenticated() && 
             (getUserData().role == 'pengurus' || getUserData().role == 'admin') && 
             getUserData().isActive == true;
    }
    
    function isActive() {
      return isAuthenticated() && getUserData().isActive == true;
    }
    
    // Users collection - authenticated users can read all (needed for profile fetch)
    // Only admins can create/update/delete
    match /users/{userId} {
      // Allow any authenticated user to read users collection
      // This is needed because when user first logs in, they need to fetch their profile
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); // Allow user creation during signup
      allow update: if isAuthenticated() && (
        // Admin can update anyone
        getUserData().role == 'admin' || 
        // User can update themselves (but not their role)
        (request.auth.uid == userId && request.resource.data.role == resource.data.role)
      );
      allow delete: if isAuthenticated() && getUserData().role == 'admin';
    }
    
    // MPA Events - authenticated users can read, pengurus+ can write
    match /artifacts/{appId}/public/data/mpa_events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isPengurus();
      allow update: if isPengurus();
      allow delete: if isAdmin();
    }
    
    // Event comments - authenticated users can read and create, own comments can be updated/deleted
    match /artifacts/{appId}/public/data/event_comments/{commentId} {
      allow read: if isActive();
      allow create: if isActive();
      allow update: if isActive() && request.auth.uid == resource.data.userId;
      allow delete: if isActive() && (request.auth.uid == resource.data.userId || isAdmin());
    }
    
    // Audit logs - admin only
    match /artifacts/{appId}/private/audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}